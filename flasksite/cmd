cat > ~/diagnose.sh <<'EOF'
#!/bin/bash

REPORT="$HOME/flasksite-diagnostic.txt"

{
    echo "=================================="
    echo " FLASKSITE DIAGNOSTIC REPORT"
    echo "=================================="
    date

    echo -e "\n===== SYSTEM INFORMATION ====="
    hostname
    hostname -I
    uname -a

    echo -e "\n===== FLASK SERVICE STATUS ====="
    sudo systemctl status flasksite.service --no-pager

    echo -e "\n===== FLASK SERVICE CONFIGURATION ====="
    sudo systemctl cat flasksite.service

    echo -e "\n===== FLASK SERVICE LOGS ====="
    sudo journalctl -u flasksite.service -n 100 --no-pager

    echo -e "\n===== GUNICORN PROCESSES ====="
    ps aux | grep '[g]unicorn'

    echo -e "\n===== NETWORK PORTS ====="
    sudo ss -ltnp

    echo -e "\n===== UNIX SOCKET ====="
    sudo ls -la /run/flasksite/

    echo -e "\n===== LOCAL FLASK TEST ====="
    curl -v --max-time 10 --unix-socket \
    /run/flasksite/flasksite.sock http://localhost/ 2>&1

    echo -e "\n===== NGINX STATUS ====="
    sudo systemctl status nginx --no-pager

    echo -e "\n===== NGINX ERROR LOG ====="
    sudo tail -n 60 /var/log/nginx/error.log

    echo -e "\n===== NGINX ACCESS LOG ====="
    sudo tail -n 30 /var/log/nginx/access.log

    echo -e "\n===== NGINX PROXY CONFIGURATION ====="
    sudo nginx -T 2>&1 | grep -n -E \
    'server_name|listen |proxy_pass|proxy_set_header|uwsgi_pass'

    echo -e "\n===== FIREWALL ====="
    sudo ufw status

    echo -e "\n===== NETWORK ROUTES ====="
    ip route

    echo -e "\n===== LOCAL NGINX TEST ====="
    curl -I --max-time 10 http://127.0.0.1/

    echo -e "\n===== END OF REPORT ====="

} > "$REPORT" 2>&1

echo "Diagnostic report created: $REPORT"
EOF

chmod +x ~/diagnose.sh
~/diagnose.sh
